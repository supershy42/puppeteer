# ==============================================================================
# MAIN .ENV - Docker Compose Environment
# ==============================================================================
# This file contains environment variables shared across all services in Docker.
# Service-specific .env files should only contain service-specific configs.
#
# Convention:
# - No spaces around = signs (KEY=value, not KEY = value)
# - Group related variables together
# - Use comments to explain non-obvious values
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update all placeholder values with your actual configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (shared across all database containers)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432

# User Service Database
DB_USER_USER=user_user
DB_USER_PASSWORD=CHANGE_ME
DB_USER_NAME=user_db
DATABASE_USER_URL=postgres://${DB_USER_USER}:${DB_USER_PASSWORD}@database_user:${POSTGRES_PORT}/${DB_USER_NAME}

# Chat Service Database
DB_CHAT_USER=chat_user
DB_CHAT_PASSWORD=CHANGE_ME
DB_CHAT_NAME=chat_db
DATABASE_CHAT_URL=postgres://${DB_CHAT_USER}:${DB_CHAT_PASSWORD}@database_chat:${POSTGRES_PORT}/${DB_CHAT_NAME}

# Game Service Database
DB_GAME_USER=game_user
DB_GAME_PASSWORD=CHANGE_ME
DB_GAME_NAME=game_db
DATABASE_GAME_URL=postgres://${DB_GAME_USER}:${DB_GAME_PASSWORD}@database_game:${POSTGRES_PORT}/${DB_GAME_NAME}

# ------------------------------------------------------------------------------
# Redis Configuration (shared across all services)
# ------------------------------------------------------------------------------
# Legacy defaults (used as fallback if service-specific Redis hosts are not set)
REDIS_HOST=redis_websockets
REDIS_PORT=6379
REDIS_DB=0
REDIS_CAPACITY=500
REDIS_PASSWORD=CHANGE_ME

# Redis for pub/sub, caching, and service events
REDIS_EVENTS_HOST=redis_events
REDIS_EVENTS_PORT=6379
REDIS_EVENTS_DB=0

# Redis for Django Channels websocket layer
REDIS_WEBSOCKETS_HOST=redis_websockets
REDIS_WEBSOCKETS_PORT=6379
REDIS_WEBSOCKETS_DB=0

# ------------------------------------------------------------------------------
# Inter-Service Communication URLs (Docker internal network)
# ------------------------------------------------------------------------------
USER_SERVICE_URL=http://user:8000/api/user/
CHAT_SERVICE_URL=http://chat:8000/api/chat/
GAME_SERVICE_URL=http://game:8000/api/game/

# JWT signing configuration (must be shared across all backend services)
JWT_SIGNING_KEY=CHANGE_ME_SHARED_SIGNING_KEY
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# Frontend API URLs (accessed via API Gateway from browser)
# ------------------------------------------------------------------------------
USER_API_URL=http://localhost/api/user
CHAT_API_URL=http://localhost/api/chat
FRIEND_API_URL=http://localhost/api/user/friend
GAME_API_URL=http://localhost/api/game

# Frontend WebSocket URLs
USER_WS_URL=ws://localhost/ws
CHAT_WS_URL=ws://localhost/ws
GAME_WS_URL=ws://localhost/ws

# Image server URL
IMG_URL=http://localhost

# ------------------------------------------------------------------------------
# Database Storage Path (host machine)
# ------------------------------------------------------------------------------
DATA_PATH=/path/to/your/data/directory

# ------------------------------------------------------------------------------
# Production Settings
# ------------------------------------------------------------------------------
DATABASE_ENGINE=postgresql
